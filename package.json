{
  "name": "foxy",
  "productName": "Foxy",
  "version": "0.1.0-alpha.1",
  "description": "Network request auditor for MetaMask Mobile: every fetch and XHR, the code that made it, the screen it came from and the team that owns it.",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "bash run.sh",
    "server": "node server.mjs",
    "desktop": "electron .",
    "test": "node --test *.test.mjs desktop/*.test.mjs",
    "smoke": "FOXY_SMOKE=1 FOXY_PORT=18098 FOXY_DATA_DIR=$(mktemp -d) electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.metamask.foxy",
    "productName": "Foxy",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/main.mjs",
      "desktop/helpers.mjs",
      "desktop/preload.cjs",
      "server.mjs",
      "lib.mjs",
      "mcp.mjs",
      "codeowners.mjs",
      "views.mjs",
      "packages.mjs",
      "setup.mjs",
      "bridge/*.ts",
      "!bridge/*.test.ts",
      "dashboard/**",
      "package.json",
      "pwa/**",
      "vendor/**",
      "skill/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roz0n/foxy.git"
  },
  "homepage": "https://github.com/roz0n/foxy#readme"
}
